# Два публичных домена (PWA + VK Mini App), общий backend. Переменные: PUBLIC_DOMAIN, PUBLIC_DOMAIN_VK.

{$PUBLIC_DOMAIN} {
    encode gzip zstd

    @backend path /api* /admin* /files* /static* /media* /v1* /editorjs*
    handle @backend {
        reverse_proxy backend_prod:8000
    }

    handle {
        reverse_proxy pwa_prod:80
    }
}

{$PUBLIC_DOMAIN_VK} {
    encode gzip zstd

    header Content-Security-Policy "frame-ancestors 'self' https://vk.com https://*.vk.com https://vk.ru https://*.vk.ru https://*.vk-apps.com"

    @backend path /api* /admin* /files* /static* /media* /v1* /editorjs*
    handle @backend {
        reverse_proxy backend_prod:8000
    }

    handle {
        reverse_proxy vk_prod:80
    }
}

{$PUBLIC_DOMAIN_MAX} {
    encode gzip zstd

    header Content-Security-Policy "frame-ancestors 'self' https://max.ru https://*.max.ru"

    @backend path /api* /admin* /files* /static* /media* /v1* /editorjs*
    handle @backend {
        reverse_proxy backend_prod:8000
    }

    handle {
        reverse_proxy max_prod:80
    }
}
