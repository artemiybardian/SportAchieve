VITE_API_BASE_URL=http://127.0.0.1:8160
# Имя бота (как в https://max.ru/<username>?startapp=…) — для справки и локальных проверок; QR в админке берёт MAX_BOT_USERNAME из бэкенда.
VITE_MAX_BOT_USERNAME=
# Базовый URL этого мини-приложения (используется для YooKassa return_url).
# При разработке через ngrok — URL туннеля на этот Vite-сервер.
VITE_MAX_APP_BASE_URL=

# Схема «только ngrok», ДЕВ:
#   Терминал A: Django на :8160 (make dev / docker compose / runserver)
#   Терминал B: make max-dev
#   Терминал C: ngrok http 5176  → HTTPS URL (добавить в кабинет MAX для партнёров)
#   Задайте VITE_MAX_APP_BASE_URL=https://<ngrok-url> и VITE_API_BASE_URL=http://127.0.0.1:8160
