VITE_API_BASE_URL=http://127.0.0.1:8160
# Числовой ID из «Короткий адрес» app12345 → 12345
VITE_VK_APP_ID=

# Схема «только ngrok», ПРОД (Docker vk_prod, порт хоста 3162):
#   docker compose --env-file backend-develop/.env --profile prod up -d … (backend_prod + vk_prod)
#   make ngrok-vk-prod
#   make vk-ngrok-hint
# Фронт собран с пустым VITE_API_BASE_URL — запросы /api на том же ngrok-хосте. Править apps/vk/.env не нужно.

# Схема «только ngrok», ДЕВ:
#   Терминал A: Django на :8160 (make dev / docker compose / runserver)
#   Терминал B: make vk-dev
#   Терминал C: make ngrok-vk-local  → два HTTPS URL (см. ngrok.vk-local.yml)
#   Терминал D: make vk-ngrok-hint  → строки для backend-develop/.env, apps/vk/.env и кабинета VK
# Либо два отдельных ngrok: make ngrok-vk-dev и make ngrok — тогда вручную пропишите VITE_API_BASE_URL и ALLOWED_HOSTS.
