# Прод: добавьте свой API-домен в ALLOWED_HOSTS и origin фронта в CORS_ALLOWED_ORIGINS.
# Docker Compose подставляет DB_HOST/CELERY из docker-compose.yml поверх этого файла.

SECRET_KEY=ikBgP-HrBZjr489mpJ7bqejLV2TyQYPyCE2FSMgD4ZGM0mdHPTo1RPOPs5RrkDc-GBU

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok.io,.ngrok.app,sportachieve.duckdns.org
CORS_ALLOWED_ORIGINS=https://localhost:5173,https://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,https://sportachieve.duckdns.org
