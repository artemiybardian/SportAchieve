SECRET_KEY=

DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3160,http://127.0.0.1:3160
FORCE_HTTPS_URLS=false

DB_ENGINE=django.db.backends.postgresql
DB_NAME=sportachieve
DB_USER=sportachieve
DB_PASSWORD=sportachieve_dev_secret
DB_HOST=127.0.0.1
DB_PORT=5432

LANGUAGE_CODE=ru-RU
TIME_ZONE=Europe/Moscow
LOG_LEVEL=DEBUG
GRAYLOG_ENDPOINT=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SECRET_PATH=

JWT_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# VK Mini App (Защищённый ключ из кабинета приложения VK)
VK_APP_ID=
VK_CLIENT_SECRET=
# VK_APP_BASE_URL — HTTPS, с которого открывается мини-приложение (доверенный URL в кабинете).
# Только ngrok: ПРОД — make ngrok-vk-prod (vk_prod :3162), затем make vk-ngrok-hint.
# ДЕВ — make ngrok-vk-local, затем make vk-ngrok-hint.
VK_APP_BASE_URL=https://sport-achieve-vk.swifttest.ru

# MAX Mini App (токен бота из кабинета MAX для партнёров business.max.ru)
MAX_BOT_TOKEN=
# Имя бота (без @), используется в QR deep link: https://max.ru/{MAX_BOT_USERNAME}?startapp={token}
MAX_BOT_USERNAME=
# MAX_APP_BASE_URL — HTTPS URL, с которого открывается мини-приложение (для CORS).
MAX_APP_BASE_URL=

# Корневой Makefile / docker compose используют backend-develop/.env для VITE_* и DB_*
VITE_API_BASE_URL=http://127.0.0.1:8160
PWA_BASE_URL=http://127.0.0.1:3160

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
