# Dependencies
**/node_modules/

# Builds & caches
**/dist/
**/dist-ssr/
**/.vite/
**/.turbo/
**/.cache/

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/
**/.venv/
**/venv/
*.egg-info/
.eggs/
pip-log.txt

# Django / runtime data (not source)
backend-develop/files/
*.sqlite3

# Logs
*.log
logs/
# Исключение: пакет Django (middleware), не каталог логов
!backend-develop/logs/
!backend-develop/logs/**
# После !.../** снова скрываем bytecode (иначе negation перекрывает **/__pycache__/)
backend-develop/logs/**/__pycache__/

# OS & editors
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local overrides (keep .env tracked per project policy)
*.local

# Secrets / keys (paths only; .env is tracked)
*.pem
